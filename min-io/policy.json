{
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "PublicRead",
        "Effect": "Allow",
        "Principal": "*",
        "Action": ["s3:GetObject"],
        "Resource": ["arn:aws:s3:::files/*"]
      },
      {
        "Sid": "PrivateWrite",
        "Effect": "Allow",
        "Principal": {
          "AWS": "*"
        },
        "Action": [
          "s3:PutObject",
          "s3:DeleteObject",
          "s3:ListBucket"
        ],
        "Resource": [
          "arn:aws:s3:::files",
          "arn:aws:s3:::files/*"
        ],
        "Condition": {
          "Bool": {
            "aws:SecureTransport": "true"
          },
          "StringNotEquals": {
            "aws:userid": "anonymous"
          }
        }
      }
    ]
  }
  