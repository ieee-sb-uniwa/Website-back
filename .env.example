# CONF
NODE_ENV='development'
SERVER_NAME='localhost'
TRAEFIK_PORT=80

# API
API_URL='http://traefik/api'

# PUBLIC PATHS
PUBLIC_FILES_URL='/files'

# MONGO
MONGO_INITDB_DATABASE='mydatabase'
MONGO_INITDB_ROOT_USERNAME='admin'
MONGO_INITDB_ROOT_PASSWORD='admin1'

# SILO (S3-compatible object storage)
SILO_ROOT_USER='admin'
SILO_ROOT_PASSWORD='admin123'
# Legacy MinIO variable fallback is also supported:
# MINIO_ROOT_USER='admin'
# MINIO_ROOT_PASSWORD='admin123'
